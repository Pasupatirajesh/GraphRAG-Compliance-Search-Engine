# sample.env — copy this file to .env and fill in your real keys.
# (.env is gitignored and never committed. Never put real keys here.)

# REQUIRED — powers embeddings, generation, and the evaluation auditor
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OPTIONAL — enables the Cohere Rerank 5 cross-encoder stage.
# Without it the pipeline falls back to deterministic token-overlap scoring.
# https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# OPTIONAL — LangSmith run tracing for debugging graph executions
LANGCHAIN_TRACING_V2=

LANGCHAIN_API_KEY=

LANGCHAIN_PROJECT=

# OPTIONAL — overrides the rerank model (default: rerank-v5.0-fast)
# COHERE_RERANK_MODEL=rerank-v5.0-pro
